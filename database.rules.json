        ".write": "(auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52') || !data.exists()"
      }
    },
    "disponibilidad": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'"
    },
    "propiedades": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'"
    },
    "citas_publicas": {
      ".read": true,
      "$slotKey": {
        ".write": "(auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52') || !data.exists()"
      }
    },
    "citas": {
      ".read": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'",
      "$citaId": {
        ".write": "(auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52') || !data.exists()"
      }
    },
    "event_trace": {
      ".read": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'",
      ".write": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'"
    }
  }
}
