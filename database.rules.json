{
  "rules": {
    "leads": {
      ".read": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'",
      ".write": "auth != null && auth.uid == 'v4wFRvNlwNPY4HtEqozpcHvjXI52'",
      "$leadId": {
        ".write": "!data.exists() && newData.child('fuente').val() == 'Agenda pública'",
        "proximaAccion": { ".write": "data.parent().exists()" },
        "fechaProximaAccion": { ".write": "data.parent().exists()" },
        "bitacora": { "$notaId": { ".write": "!data.exists() && data.parent().parent().exists()" } }
      }
    },
    "telefonos_index": {
      ".read": false,
      "$telefono": {
