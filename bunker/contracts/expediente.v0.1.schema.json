{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BunkerExpedienteV01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "leadId",
    "status",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "leadId": {
      "type": "string",
      "minLength": 1
    },
    "propertyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "unitId": {
      "type": [
        "string",
        "null"
      ]
    },
    "contractId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "abierto",
        "en_revision",
        "completo",
        "archivado"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    }
  }
}
